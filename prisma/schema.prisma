generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== OTP MODELS ====================
enum OtpType {
  ACCOUNT_VERIFY
  FORGOT_PASSWORD
}

model Otp {
  id         String    @id @default(uuid())
  email      String
  code       Int
  type       OtpType
  isUsed     Boolean   @default(false)
  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  attempts   Int       @default(0)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updateAt   DateTime  @updatedAt

  @@index([email])
  @@map("otps")
}


// =================== CORE USER MODELS ===================
enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  password     String
  phone        String?
  dateOfBirth  DateTime?
  gender       Gender?
  address      String?
  profileImage String?
  role         UserRole  @default(PATIENT)
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Profiles
  doctorProfile  Doctor?
  patientProfile Patient?

  // Notifications & audit
  notifications Notification[]
  auditLogs     AuditLog[]

  // Chat
  messages ChatMessage[] // sender

  // Unified transaction ledger
  transactions Transaction[]

  @@index([role])
  @@map("users")
}

model Doctor {
  id              String  @id @default(uuid())
  userId          String  @unique
  departmentId    String?
  specialties     String?
  qualification   String?
  experience      Int?    // total years
  bio             String?
  timezone        String? // e.g. "Asia/Dhaka"
  consultationFee Decimal @db.Decimal(10, 2) @default(0.00)
  balance         Decimal @db.Decimal(10, 2) @default(0.00) // wallet balance
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department?         @relation(fields: [departmentId], references: [id])
  schedules          Schedule[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]
  reviews            Review[]
  payouts            DoctorPayout[]
  withdrawals        Withdrawal[]

  @@map("doctors")
}

model Patient {
  id               String   @id @default(uuid())
  userId           String   @unique
  bloodGroup       String?
  emergencyContact String?
  medicalHistory   String?
  allergies        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  reviews      Review[]

  @@map("patients")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  icon        String?
  description String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors Doctor[]

  @@map("departments")
}

// =================== SCHEDULING ===================
model Schedule {
  id                  String   @id @default(uuid())
  doctorId            String
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int      @default(60)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@map("schedules")
}

model ScheduleException {
  id           String   @id @default(uuid())
  doctorId     String
  date         DateTime // date-only semantics; store at UTC midnight
  closed       Boolean  @default(false)
  startTime    String?
  endTime      String?
  blockedSlots String[] @default([])
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, date])
  @@map("schedule_exceptions")
}


// =================== BOOKING / CONSULTATION ===================
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Appointment {
  id           String            @id @default(uuid())
  patientId    String
  doctorId     String
  startsAt     DateTime
  endsAt       DateTime
  currency     String            @default("BDT")
  price        Decimal           @db.Decimal(10, 2)
  status       AppointmentStatus @default(PENDING)
  cancelReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultation Consultation?
  payments     Payment[]
  payout       DoctorPayout?

  @@unique([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([doctorId, startsAt])
  @@map("appointments")
}

model Consultation {
  id            String             @id @default(uuid())
  appointmentId String             @unique
  status        ConsultationStatus @default(SCHEDULED)
  notes         String?
  roomId        String?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
  calls         Call[]

  @@map("consultations")
}

model Prescription {
  id             String    @id @default(uuid())
  consultationId String
  medicines      Json?
  instructions   String
  diagnosis      String?
  nextVisit      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}


// =================== PAYMENTS ===================
// Records patient payments via Stripe Checkout (for appointment booking)
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  appointmentId   String
  amount          Int           // amount in smallest currency unit (cents/paisa)
  currency        String        @default("BDT")
  externalId      String        @unique // Stripe Checkout Session ID
  paymentIntentId String?       // Stripe Payment Intent ID
  method          String        @default("card")
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointment Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  payout      DoctorPayout?

  @@map("payments")
}

// =================== ESCROW / DOCTOR PAYOUTS ===================
// Tracks how much the platform owes a doctor per appointment
enum PayoutStatus {
  PENDING  // payment received; consultation not yet complete
  PAID     // consultation completed; credited to doctor wallet
  VOIDED   // appointment cancelled/refunded — payout will never happen
}

model DoctorPayout {
  id               String       @id @default(uuid())
  appointmentId    String       @unique
  doctorId         String
  paymentId        String       @unique
  amount           Decimal      @db.Decimal(10, 2) // gross payment amount
  commissionRate   Decimal      @db.Decimal(5, 4)  // e.g. 0.1000 = 10%
  commissionAmount Decimal      @db.Decimal(10, 2) // platform keeps this
  doctorAmount     Decimal      @db.Decimal(10, 2) // doctor receives this (amount - commission)
  currency         String       @default("BDT")
  status           PayoutStatus @default(PENDING)
  eligibleAt       DateTime?    // when consultation completed
  paidAt           DateTime?    // when credited to doctor wallet
  noShowAt         DateTime?    // set if doctor missed slot
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([doctorId, status])
  @@map("doctor_payouts")
}

// =================== WITHDRAWALS ===================
// Tracks doctor card withdrawal requests (instant, no approval needed)
enum WithdrawalStatus {
  SUCCESS
  FAILED
}

model Withdrawal {
  id             String           @id @default(uuid())
  doctorId       String
  amount         Decimal          @db.Decimal(10, 2)
  currency       String           @default("BDT")
  status         WithdrawalStatus @default(SUCCESS)
  cardBrand      String
  cardLast4      String
  cardHolderName String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([doctorId])
  @@map("withdrawals")
}

// =================== TRANSACTIONS ===================
// Unified financial transaction ledger for any user and any event
enum TransactionType {
  CREDIT      // money coming in (doctor earning, etc.)
  DEBIT       // money going out (withdrawal, refund, etc.)
}

enum TransactionStatus {
  SUCCESS
  FAILED
}

model Transaction {
  id           String            @id @default(uuid())
  userId       String            // which user this belongs to
  amount       Decimal           @db.Decimal(10, 2)
  currency     String            @default("BDT")
  type         TransactionType
  status       TransactionStatus @default(SUCCESS)
  description  String
  referenceId  String?           // e.g. appointmentId, withdrawalId, paymentId
  withdrawalId String?           // linked withdrawal if this is a debit for withdrawal
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, type])
  @@index([createdAt])
  @@map("transactions")
}

// =================== COMMUNICATION ===================
enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
}

enum CallType {
  VOICE
  VIDEO
}

model ChatThread {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@unique([patientId, doctorId])
  @@index([patientId, doctorId])
  @@map("chat_threads")
}

model ChatMessage {
  id             String      @id @default(uuid())
  threadId       String
  senderId       String
  consultationId String?
  type           MessageType @default(TEXT)
  text           String?
  attachment     String?
  isRead         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

enum CallStatus {
  INITIATED
  RINGING
  ANSWERED
  REJECTED
  ENDED
  MISSED
}

model Call {
  id             String     @id @default(uuid())
  consultationId String
  type           CallType
  status         CallStatus @default(INITIATED)
  roomId         String?
  recordingUrl   String?
  notes          String?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, type])
  @@map("calls")
}

// =================== REVIEWS / NOTIFICATIONS / AUDIT ===================

model Review {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@map("reviews")
}

enum NotificationType {
  APPOINTMENT
  PRESCRIPTION
  PAYMENT
  SYSTEM
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  type      NotificationType?
  title     String
  message   String
  data      Json?
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
